{
  "name": "codebase-qa-doc-generator",
  "displayName": "代码库智能问答与文档生成",
  "description": "基于RAG的代码库智能问答和文档生成插件",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codebase-qa-doc-generator.askQuestion",
    "onCommand:codebase-qa-doc-generator.generateDoc"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codebase-qa-doc-generator.askQuestion",
        "title": "智能问答"
      },
      {
        "command": "codebase-qa-doc-generator.generateDoc",
        "title": "生成文档"
      }
    ]
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
